; Engine configuration file.
; Dust & Dollars — prototype Godot 4 (GDScript only, web-first).

config_version=5

[application]

config/name="Dust & Dollars"
config/description="Braquage de banque western cartoon en 2D vue de dessus, jouable au navigateur."
run/main_scene="res://scenes/Boot.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/icon.svg"

[autoload]

SaveManager="*res://scripts/save_manager.gd"
GameManager="*res://scripts/game_manager.gd"
InputManager="*res://scripts/input_manager.gd"
AudioManager="*res://scripts/audio_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

